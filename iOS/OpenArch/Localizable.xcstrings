    },
    "Dieser Link stammt aus einer neueren OpenArch-Version.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link comes from a newer version of OpenArch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace procede de una versión más reciente de OpenArch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien provient d’une version plus récente d’OpenArch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo link proviene da una versione più recente di OpenArch."
          }
        }
      },
      "extractionState": "manual"
    },
    "Du folgst dieser Freigabe schon.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already follow this share."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya sigues este elemento compartido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous suivez déjà ce partage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui già questa condivisione."
          }
        }
      }
    },
    "Eine Momentaufnahme: Der Link enthält die Lesezeichen selbst, verschlüsselt, und ändert sich nicht mehr.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A snapshot: the link contains the bookmarks themselves, encrypted, and never changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una instantánea: el enlace contiene los propios marcadores, cifrados, y ya no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un instantané : le lien contient les signets eux-mêmes, chiffrés, et ne change plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
