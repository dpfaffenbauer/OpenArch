    "Beim Folgen erscheinen Änderungen des Besitzers von selbst; was du daran änderst, überschreibt das nächste Update.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you follow, the owner's changes appear by themselves; anything you change is overwritten by the next update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al seguir el contenido compartido, los cambios del propietario aparecen automáticamente; la siguiente actualización sobrescribe los cambios que hagas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous suivez le partage, les modifications du propriétaire apparaissent automatiquement ; la prochaine mise à jour écrase vos propres modifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se segui la condivisione, le modifiche del proprietario appaiono automaticamente; il prossimo aggiornamento sovrascrive le tue modifiche."
          }
        }
      }
    },
    "Code scannen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan Code"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanear código"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanner un code"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona codice"
          }
        }
      }
    },
    "Das Passwort stimmt nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password is wrong."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña no es correcta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe est incorrect."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password non è corretta."
          }
        }
      },
      "extractionState": "manual"
    },
    "Das ist deine eigene Freigabe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your own share."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es tu propio contenido compartido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est votre propre partage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è la tua condivisione."
          }
        }
      }
    },
    "Das ist kein gültiger OpenArch-Link.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a valid OpenArch link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es un enlace de OpenArch válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas un lien OpenArch valide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è un link OpenArch valido."
          }
        }
      },
      "extractionState": "manual"
    },
    "Der Link zeigt danach nichts mehr. Wer die Lesezeichen hinzugefügt hat, behält den letzten Stand.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link shows nothing afterwards. Anyone who added the bookmarks keeps the last version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, el enlace ya no mostrará nada. Quien haya añadido los marcadores conservará la última versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien n’affichera plus rien. Ceux qui ont ajouté les signets conservent leur dernier état."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo, il link non mostra più nulla. Chi ha aggiunto i segnalibri conserva l’ultima versione."
          }
        }
      }
    },
    "Der Server lieferte einen älteren Stand als bekannt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server returned an older version than the one known."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor devolvió una versión más antigua que la ya conocida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a renvoyé une version plus ancienne que celle déjà connue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha restituito una versione più vecchia di quella già nota."
          }
        }
      },
      "extractionState": "manual"
    },
    "Der Teilen-Server antwortete mit Fehler %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The share server answered with error %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor para compartir respondió con el error %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de partage a répondu avec l’erreur %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server di condivisione ha risposto con l’errore %lld."
          }
        }
      },
      "extractionState": "manual"
    },
    "Der Teilen-Server ist nicht erreichbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The share server can't be reached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder al servidor para compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de partage est injoignable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server di condivisione non è raggiungibile."
          }
        }
      },
      "extractionState": "manual"
    },
    "Die Freigabe wurde beendet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing was stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha dejado de compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage a été arrêté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La condivisione è stata interrotta."
          }
        }
      },
      "extractionState": "manual"
    },
    "Die Lesezeichen liegen verschlüsselt auf dem Teilen-Server; der Schlüssel steht nur im Link. Änderungen erscheinen bei allen mit dem Link.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bookmarks are stored encrypted on the share server; the key is only in the link. Changes appear for everyone with the link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los marcadores se guardan cifrados en el servidor de uso compartido; la clave solo está en el enlace. Los cambios aparecen para todas las personas que tienen el enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris sont stockés chiffrés sur le serveur de partage ; la clé se trouve uniquement dans le lien. Les modifications apparaissent pour toutes les personnes disposant du lien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I segnalibri sono archiviati cifrati sul server di condivisione; la chiave è solo nel link. Le modifiche appaiono a chiunque abbia il link."
          }
        }
      }
    },
    "Die Lesezeichen reisen verschlüsselt im Link selbst; kein Server ist beteiligt. Spätere Änderungen erscheinen nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bookmarks travel encrypted inside the link itself; no server is involved. Later changes don't appear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los marcadores viajan cifrados en el propio enlace; no interviene ningún servidor. Los cambios posteriores no aparecen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris voyagent chiffrés dans le lien lui-même ; aucun serveur n’intervient. Les modifications ultérieures n’apparaissent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I segnalibri viaggiano cifrati nel link stesso; non è coinvolto alcun server. Le modifiche successive non appaiono."
          }
        }
      }
    },
    "Die geteilten Daten sind beschädigt oder wurden verändert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared data is damaged or was changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos compartidos están dañados o se han modificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données partagées sont endommagées ou ont été modifiées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati condivisi sono danneggiati o sono stati modificati."
          }
        }
      },
      "extractionState": "manual"
    },
