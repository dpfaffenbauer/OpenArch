    "Tabs unter der Linie, die du so lange nicht angesehen hast, kommen ins Archiv, wie auf dem Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs below the line that you haven't looked at for this long move to the archive, just like on the Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas debajo de la línea que no has mirado durante este tiempo pasan al archivo, como en el Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets sous la ligne que vous n’avez pas consultés depuis ce délai vont dans les archives, comme sur le Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schede sotto la linea che non guardi da questo tempo finiscono nell’archivio, come sul Mac."
          }
        }
      }
    },
