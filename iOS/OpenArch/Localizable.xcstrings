            "state": "translated",
            "value": "Questa condivisione non esiste (più)."
          }
        }
      },
      "extractionState": "manual"
    },
    "Diese Lesezeichen sind mit einem Passwort geschützt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These bookmarks are protected with a password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos marcadores están protegidos con contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces signets sont protégés par mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi segnalibri sono protetti da password."
          }
        }
      }
    },
    "Dieser Link ist mit einem Passwort geschützt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link is protected with a password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace está protegido con contraseña."
          }
        },
        "fr": {
