    "Für neue Live-Freigaben. Leer lassen für share.openarch.app; ein eigener Server muss relay/ aus OpenArchs Quellcode sein und https sprechen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For new live shares. Leave empty for share.openarch.app; your own server must run relay/ from OpenArch's source code and speak https."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para nuevos contenidos compartidos en directo. Déjalo vacío para usar share.openarch.app; un servidor propio debe ejecutar relay/ del código fuente de OpenArch y usar https."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les nouveaux partages en direct. Laissez vide pour share.openarch.app ; un serveur personnel doit exécuter relay/ du code source d’OpenArch et utiliser https."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per le nuove condivisioni live. Lascia vuoto per share.openarch.app; un server personale deve eseguire relay/ dal codice sorgente di OpenArch e usare https."
          }
        }
      }
    },
