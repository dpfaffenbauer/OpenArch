    "Scanne den Code mit OpenArch auf dem iPhone oder Mac (Code scannen), oder öffne den Link dort. Der Schlüssel steht hinter dem # und erreicht nie einen Server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the code with OpenArch on iPhone or Mac (Scan Code), or open the link there. The key is after the # and never reaches a server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código con OpenArch en el iPhone o el Mac (Escanear código) o abre allí el enlace. La clave va detrás del # y nunca llega a un servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code avec OpenArch sur l’iPhone ou le Mac (Scanner un code), ou ouvrez-y le lien. La clé se trouve après le # et n’atteint jamais aucun serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona il codice con OpenArch su iPhone o Mac (Scansiona codice), oppure apri lì il link. La chiave si trova dopo il # e non raggiunge mai un server."
          }
        }
      }
    },
