<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- OpenArchFairPlay, the helper that plays Spotify's tracks for Chromium
     pages (FairPlay.swift): sandboxed, with nothing but the network, which
     it needs for the track's segments and its cover. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.security.network.client</key><true/>
</dict>
</plist>
